# Copy this file to .env and fill in real values.

# Neon Postgres, pgvector-enabled.
# DATABASE_URL = pooled connection (host has "-pooler"), used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# DIRECT_URL = direct connection (same host WITHOUT "-pooler"), used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Groq API key (answers) — https://console.groq.com
GROQ_API_KEY=""

# Google AI Studio API key (embeddings) — https://aistudio.google.com
GOOGLE_API_KEY=""

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=""
